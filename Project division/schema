-- Solar Care AI schema v1  (run in Supabase: SQL Editor -> New query -> paste -> Run)
-- Matches MASTER BRIEF v2. API uses the service-role key and must check home ownership itself.
 
create extension if not exists "pgcrypto";
 
create table if not exists homes (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users(id) on delete cascade,
  name text not null default 'My home',
  city text,
  lat double precision,
  lon double precision,
  family_size int,
  system_kw numeric,                       -- installed/planned solar kW (used in Part 2)
  created_at timestamptz not null default now()
);
 
create table if not exists appliance_catalog (
  id uuid primary key default gen_random_uuid(),
  type text not null,
  brand text,
  model text,
  capacity_value numeric,
  capacity_unit text,                      -- ton | btu | litre | kg | inch | cu_ft | hp | va | watt
  rated_watts numeric not null,
  duty_factor numeric not null default 1.0 check (duty_factor > 0 and duty_factor <= 1),
  inverter boolean,
  surge_factor numeric not null default 1.0 check (surge_factor >= 1),
  default_hours numeric,
  source text,                             -- typical | label | brand_site
  verified boolean not null default false,
  notes text,
  created_at timestamptz not null default now()
);
 
create table if not exists home_appliances (
  id uuid primary key default gen_random_uuid(),
  home_id uuid not null references homes(id) on delete cascade,
  room text,
  type text not null,
  brand text,
  model text,
  capacity_value numeric,
  capacity_unit text,
  inverter boolean,
  watts numeric not null check (watts >= 0),
  duty_factor numeric not null default 1.0 check (duty_factor > 0 and duty_factor <= 1),
  surge_factor numeric not null default 1.0 check (surge_factor >= 1),
  qty int not null default 1 check (qty >= 1),
  hourly_use jsonb not null default '[]'::jsonb,   -- 24 numbers, each 0..1
  is_essential boolean not null default false,
  source_tag text not null default 'user' check (source_tag in ('label','catalog','guess','user')),
  confidence numeric,
  user_verified boolean not null default false,
  image_path text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create index if not exists idx_home_appliances_home on home_appliances(home_id);
 
create table if not exists detections (
  id uuid primary key default gen_random_uuid(),
  home_id uuid not null references homes(id) on delete cascade,
  room text,
  image_path text,
  backend text,                            -- vlm | yolo
  predicted jsonb not null default '[]'::jsonb,
  final jsonb,                             -- what the user confirmed/corrected (training data)
  created_at timestamptz not null default now()
);
 
create table if not exists bills (
  id uuid primary key default gen_random_uuid(),
  home_id uuid not null references homes(id) on delete cascade,
  month date not null,                     -- first day of the billing month
  units_kwh numeric not null,
  raw jsonb,
  created_at timestamptz not null default now(),
  unique (home_id, month)
);
 
create table if not exists daily_logs (
  id uuid primary key default gen_random_uuid(),
  home_id uuid not null references homes(id) on delete cascade,
  log_date date not null,
  ac_hours numeric,
  outage_hours numeric,
  guests boolean,
  meter_kwh numeric,
  notes text,
  created_at timestamptz not null default now(),
  unique (home_id, log_date)
);
 
create table if not exists sizing_reports (
  id uuid primary key default gen_random_uuid(),
  home_id uuid not null references homes(id) on delete cascade,
  input jsonb not null,
  result jsonb not null,
  created_at timestamptz not null default now()
);
 
-- ---------- Row Level Security ----------
alter table homes enable row level security;
create policy "own homes" on homes for all
  using (user_id = auth.uid()) with check (user_id = auth.uid());
 
alter table home_appliances enable row level security;
create policy "own appliances" on home_appliances for all
  using (exists (select 1 from homes h where h.id = home_appliances.home_id and h.user_id = auth.uid()))
  with check (exists (select 1 from homes h where h.id = home_appliances.home_id and h.user_id = auth.uid()));
 
alter table detections enable row level security;
create policy "own detections" on detections for all
  using (exists (select 1 from homes h where h.id = detections.home_id and h.user_id = auth.uid()))
  with check (exists (select 1 from homes h where h.id = detections.home_id and h.user_id = auth.uid()));
 
alter table bills enable row level security;
create policy "own bills" on bills for all
  using (exists (select 1 from homes h where h.id = bills.home_id and h.user_id = auth.uid()))
  with check (exists (select 1 from homes h where h.id = bills.home_id and h.user_id = auth.uid()));
 
alter table daily_logs enable row level security;
create policy "own daily logs" on daily_logs for all
  using (exists (select 1 from homes h where h.id = daily_logs.home_id and h.user_id = auth.uid()))
  with check (exists (select 1 from homes h where h.id = daily_logs.home_id and h.user_id = auth.uid()));
 
alter table sizing_reports enable row level security;
create policy "own reports" on sizing_reports for all
  using (exists (select 1 from homes h where h.id = sizing_reports.home_id and h.user_id = auth.uid()))
  with check (exists (select 1 from homes h where h.id = sizing_reports.home_id and h.user_id = auth.uid()));
 
alter table appliance_catalog enable row level security;
create policy "catalog readable" on appliance_catalog for select to authenticated using (true);
 
